# Komplekku runs locally only. Replace these development values before any future production use.
APP_ENV=local
NODE_ENV=development

WEB_PORT=3000
API_PORT=3001
# 0.0.0.0 lets a physical phone on the same LAN reach the API; use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Port 5433 avoids the PostgreSQL instance already using host port 5432.
POSTGRES_PORT=5433
POSTGRES_DB=komplekku
POSTGRES_TEST_DB=komplekku_test
POSTGRES_USER=komplekku
POSTGRES_PASSWORD=komplekku_local_only
DATABASE_URL=postgresql://komplekku:komplekku_local_only@localhost:5433/komplekku?schema=public
TEST_DATABASE_URL=postgresql://komplekku:komplekku_local_only@localhost:5433/komplekku_test?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=komplekku
MINIO_ROOT_PASSWORD=komplekku_local_only
MINIO_BUCKETS=avatars,announcements,reports,incidents,packages,payments,letters,community

MAIL_DRIVER=mailpit
MAIL_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

AUTH_MODE=development
ALLOW_DEV_OTP=true
DEV_OTP=123456
SESSION_COOKIE_NAME=komplekku_session

# Optional, production only: lets one specific phone number skip the WhatsApp
# bot entirely and log in with this fixed code instead. Leave both unset to
# disable. Set only in Railway's env vars, never commit real values here.
# OTP_BYPASS_PHONE_E164=+62XXXXXXXXXXX
# OTP_BYPASS_CODE=000000

# Required to run `pnpm --filter @komplekku/api db:seed:production` once
# against a fresh production database. Set only in Railway's env vars (or a
# local, gitignored env file) - these are real identifying details and must
# never be committed with real values.
# BOOTSTRAP_COMMUNITY_SLUG=your-community-slug
# BOOTSTRAP_COMMUNITY_NAME=Your Community Name
# BOOTSTRAP_COMMUNITY_ADDRESS=Your Community Address
# BOOTSTRAP_COMMUNITY_TIMEZONE=Asia/Jakarta
# BOOTSTRAP_ADMIN_HOUSE_CODE=YOUR-HOUSE-CODE
# BOOTSTRAP_ADMIN_HOUSE_BLOCK=YOUR-BLOCK
# BOOTSTRAP_ADMIN_HOUSE_NUMBER=YOUR-NUMBER
# BOOTSTRAP_ADMIN_PHONE_E164=+62XXXXXXXXXXX
# BOOTSTRAP_ADMIN_FULL_NAME=Your Name
# BOOTSTRAP_ADMIN_HOUSEHOLD_NAME=Your Household Name

CCTV_MODE=mock
CCTV_GATEWAY_URL=http://localhost:8889
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_ICE_PORT=8189
MEDIAMTX_API_PORT=9997

# ── In-app APK updater ────────────────────────────────────────────────
# Where the released APK is hosted, and which build it is. Leave MOBILE_APK_URL
# unset to disable update prompts entirely — the endpoint then reports "no
# update available" and the app never asks.
#
# MOBILE_LATEST_VERSION_CODE must match the `+N` build number in
# apps/mobile/pubspec.yaml for the release you uploaded.
MOBILE_LATEST_VERSION_CODE=2
MOBILE_LATEST_VERSION_NAME=0.2.0
MOBILE_APK_URL=https://example.com/komplekku/app-release.apk
MOBILE_UPDATE_MANDATORY=false
MOBILE_RELEASE_NOTES=Papan diskusi forum, kalender agenda, dan perbaikan adzan otomatis.
