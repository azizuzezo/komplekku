# Komplekku runs locally only. Replace these development values before any future production use.
APP_ENV=local
NODE_ENV=development

WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Port 5433 avoids the PostgreSQL instance already using host port 5432.
POSTGRES_PORT=5433
POSTGRES_DB=komplekku
POSTGRES_TEST_DB=komplekku_test
POSTGRES_USER=komplekku
POSTGRES_PASSWORD=komplekku_local_only
DATABASE_URL=postgresql://komplekku:komplekku_local_only@localhost:5433/komplekku?schema=public
TEST_DATABASE_URL=postgresql://komplekku:komplekku_local_only@localhost:5433/komplekku_test?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=komplekku
MINIO_ROOT_PASSWORD=komplekku_local_only
MINIO_BUCKETS=avatars,announcements,reports,incidents,packages,payments,letters,community

MAIL_DRIVER=mailpit
MAIL_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

AUTH_MODE=development
ALLOW_DEV_OTP=true
DEV_OTP=123456
SESSION_COOKIE_NAME=komplekku_session

CCTV_MODE=mock
CCTV_GATEWAY_URL=http://localhost:8889
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_ICE_PORT=8189
MEDIAMTX_API_PORT=9997
