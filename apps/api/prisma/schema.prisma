  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  community      Community             @relation(fields: [communityId], references: [id], onDelete: Restrict)
  facility       Facility              @relation(fields: [facilityId, communityId], references: [id, communityId], onDelete: Restrict)
  household      Household             @relation(fields: [householdId, communityId], references: [id, communityId], onDelete: Restrict)
  bookedBy       User                  @relation("FacilityBookingCreator", fields: [bookedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, communityId])
  @@index([communityId, facilityId, bookingDate, status])
  @@index([communityId, householdId])
  @@map("facility_bookings")
}

model DuesType {
  id            String    @id @default(uuid()) @db.Uuid
  communityId   String    @map("community_id") @db.Uuid
  name          String    @db.VarChar(160)
  description   String?   @db.Text
  defaultAmount Int       @map("default_amount")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  community     Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  invoices      Invoice[]

  @@unique([id, communityId])
  @@index([communityId, isActive])
  @@map("dues_types")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  communityId    String        @map("community_id") @db.Uuid
  householdId    String        @map("household_id") @db.Uuid
  duesTypeId     String        @map("dues_type_id") @db.Uuid
  period         String        @db.VarChar(7)
  amount         Int
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(UNPAID)
  waivedAt       DateTime?     @map("waived_at") @db.Timestamptz(3)
  waivedByUserId String?       @map("waived_by_user_id") @db.Uuid
  waivedReason   String?       @map("waived_reason") @db.Text
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  community      Community     @relation(fields: [communityId], references: [id], onDelete: Restrict)
  household      Household     @relation(fields: [householdId, communityId], references: [id, communityId], onDelete: Restrict)
  duesType       DuesType      @relation(fields: [duesTypeId, communityId], references: [id, communityId], onDelete: Restrict)
  waivedBy       User?         @relation("InvoiceWaivedBy", fields: [waivedByUserId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@unique([id, communityId])
  @@unique([householdId, duesTypeId, period])
  @@index([communityId, status, dueDate])
  @@index([communityId, householdId])
  @@map("invoices")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  communityId       String        @map("community_id") @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  submittedByUserId String        @map("submitted_by_user_id") @db.Uuid
  amount            Int
  paidAt            DateTime      @map("paid_at") @db.Date
  note              String        @db.VarChar(300)
  status            PaymentStatus @default(PENDING)
  verifiedByUserId  String?       @map("verified_by_user_id") @db.Uuid
  verifiedAt        DateTime?     @map("verified_at") @db.Timestamptz(3)
  rejectionReason   String?       @map("rejection_reason") @db.Text
  receiptNumber     String?       @unique @map("receipt_number") @db.VarChar(40)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  community         Community     @relation(fields: [communityId], references: [id], onDelete: Restrict)
  invoice           Invoice       @relation(fields: [invoiceId, communityId], references: [id, communityId], onDelete: Restrict)
  submittedBy       User          @relation("PaymentSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  verifiedBy        User?         @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, communityId])
  @@index([communityId, status])
  @@index([communityId, invoiceId])
  @@map("payments")
}

model CashTransaction {
  id               String              @id @default(uuid()) @db.Uuid
  communityId      String              @map("community_id") @db.Uuid
  date             DateTime            @db.Date
  category         String              @db.VarChar(120)
  description      String              @db.Text
  amount           Int
  type             CashTransactionType
  visibility       CashVisibility      @default(PUBLIC_TO_RESIDENTS)
  recordedByUserId String              @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  community        Community           @relation(fields: [communityId], references: [id], onDelete: Restrict)
  recordedBy       User                @relation("CashTransactionRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([id, communityId])
  @@index([communityId, date])
  @@index([communityId, visibility, date])
  @@map("cash_transactions")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  communityId String?    @map("community_id") @db.Uuid
  actorUserId String?    @map("actor_user_id") @db.Uuid
  sessionId   String?    @map("session_id") @db.Uuid
  action      String     @db.VarChar(120)
  entityType  String     @map("entity_type") @db.VarChar(120)
  entityId    String?    @map("entity_id") @db.Uuid
  ipAddress   String?    @map("ip_address") @db.VarChar(64)
  userAgent   String?    @map("user_agent") @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Restrict)
  actor       User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  session     Session?   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([communityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model PushToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  token       String    @unique @db.VarChar(500)
  platform    String    @default("ANDROID") @db.VarChar(32)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, userId])
  @@map("push_tokens")
}

