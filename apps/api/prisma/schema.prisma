generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ResidentStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
  MOVED_OUT
}

enum OccupancyStatus {
  OWNER_OCCUPIED
  RENTED
  VACANT
}

enum VehicleType {
  CAR
  MOTORCYCLE
  BICYCLE
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum HouseholdRelationship {
  HEAD
  SPOUSE
  CHILD
  PARENT
  RELATIVE
  TENANT
  OTHER
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

/// How an announcement is filed on the noticeboard, which is a separate
/// question from how urgent it is. The "Penting" chip warga see is derived
/// from `priority`, not stored here, so the two can never contradict each
/// other — see `announcementBadge` in the contracts package.
enum AnnouncementCategory {
  INFO
  EVENT
}

enum NotificationPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum CameraAccessLevel {
  RESIDENT
  SECURITY
  ADMIN_ONLY
}

enum CameraStatus {
  ONLINE
  OFFLINE
}

enum EmergencyKind {
  SECURITY
  MEDICAL
  FIRE
  ENVIRONMENTAL
  OTHER
}

enum EmergencyStatus {
  SENT
  ACKNOWLEDGED
  RESPONDING
  RESOLVED
}

enum VisitorStatus {
  PENDING
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PackageStatus {
  RECEIVED
  NOTIFIED
  COLLECTED
}

enum SecurityShiftStatus {
  ACTIVE
  COMPLETED
}

enum PatrolSessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum IncidentCategory {
  SECURITY
  SUSPICIOUS_ACTIVITY
  DAMAGE
  NOISE
  TRAFFIC
  LOST_ITEM
  EMERGENCY
  OTHER
}

enum IncidentStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ReportCategory {
  STREET_LIGHT
  TRASH
  DRAINAGE
  SECURITY
  FACILITY
  CLEANLINESS
  NOISE
  OTHER
}

enum ReportStatus {
  SUBMITTED
  RECEIVED
  IN_PROGRESS
  COMPLETED
}

enum LetterRequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  READY
}

enum FacilityBookingStatus {
  CONFIRMED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  OVERDUE
  WAIVED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CashTransactionType {
  INCOME
  EXPENSE
}

enum CashVisibility {
  PUBLIC_TO_RESIDENTS
  ADMIN_ONLY
}

/// SYSTEM channels are the community-wide and per-RT "Forum Warga" seeded
/// automatically; PRIVATE channels are opened by a warga and readable only by
/// the residents they invited and who accepted.
enum ForumChannelKind {
  SYSTEM
  PRIVATE
}

enum ForumMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// What a discussion-board post is for. Chat channels have no equivalent —
/// this only applies to the threaded board.
enum ForumPostCategory {
  QUESTION
  SUGGESTION
  INFORMATION
  ENVIRONMENT
  ACTIVITY
}

model Community {
  id                    String             @id @default(uuid()) @db.Uuid
  slug                  String             @unique @db.VarChar(80)
  name                  String             @db.VarChar(160)
  address               String?            @db.Text
  timezone              String             @default("Asia/Jakarta") @db.VarChar(64)
  rwLabel               String?            @map("rw_label") @db.VarChar(60)
  contactPhone          String?            @map("contact_phone") @db.VarChar(24)
  emergencyContactPhone String?            @map("emergency_contact_phone") @db.VarChar(24)
  registrationOpen      Boolean            @default(true) @map("registration_open")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)
  sessions              Session[]          @relation("CurrentCommunity")
  userRoles             UserRole[]
  rts                   Rt[]
  houses                House[]
  households            Household[]
  householdMembers      HouseholdMember[]
  residents             Resident[]
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  events                Event[]
  notifications         Notification[]
  vehicles              Vehicle[]
  cameras               Camera[]
  emergencies           Emergency[]
  visitors              Visitor[]
  packages              Package[]
  securityShifts        SecurityShift[]
  patrolCheckpoints     PatrolCheckpoint[]
  patrolSessions        PatrolSession[]
  patrolScans           PatrolScan[]
  incidents             Incident[]
  reports               Report[]
  reportUpdates         ReportUpdate[]
  letterTypes           LetterType[]
  letterRequests        LetterRequest[]
  facilities            Facility[]
  facilityBookings      FacilityBooking[]
  duesTypes             DuesType[]
  invoices              Invoice[]
  payments              Payment[]
  cashTransactions      CashTransaction[]
  pushTokens            PushToken[]
  auditLogs             AuditLog[]
  forumChannels         ForumChannel[]
  forumMessages         ForumMessage[]
  forumChannelMembers   ForumChannelMember[]
  forumPosts            ForumPost[]
  forumPostReplies      ForumPostReply[]
  forumPostLikes        ForumPostLike[]
  forumReplyLikes       ForumReplyLike[]

  @@map("communities")
}

model User {
  id                       String             @id @default(uuid()) @db.Uuid
  phoneE164                String             @unique @map("phone_e164") @db.VarChar(16)
  displayName              String?            @map("display_name") @db.VarChar(160)
  allowResidentContact     Boolean            @default(false) @map("allow_resident_contact")
  status                   UserStatus         @default(ACTIVE)
  phoneVerifiedAt          DateTime?          @map("phone_verified_at") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                 Session[]
  userRoles                UserRole[]
  residents                Resident[]         @relation("ResidentUser")
  approvedResidents        Resident[]         @relation("ResidentApprover")
  rejectedResidents        Resident[]         @relation("ResidentRejector")
  announcementReads        AnnouncementRead[]
  authoredNotices          Announcement[]     @relation("AnnouncementAuthor")
  createdEvents            Event[]            @relation("EventCreator")
  archivedEvents           Event[]            @relation("EventArchiver")
  notifications            Notification[]     @relation("NotificationRecipient")
  sentEmergencies          Emergency[]        @relation("EmergencySender")
  acknowledgedEmergencies  Emergency[]        @relation("EmergencyAcknowledger")
  resolvedEmergencies      Emergency[]        @relation("EmergencyResolver")
  createdVisitors          Visitor[]          @relation("VisitorCreator")
  checkedInVisitors        Visitor[]          @relation("VisitorCheckedInBy")
  checkedOutVisitors       Visitor[]          @relation("VisitorCheckedOutBy")
  receivedPackages         Package[]          @relation("PackageReceivedBy")
  collectedPackages        Package[]          @relation("PackageCollectedBy")
  securityShifts           SecurityShift[]
  patrolSessions           PatrolSession[]
  reportedIncidents        Incident[]         @relation("IncidentReporter")
  reportedReports          Report[]           @relation("ReportReporter")
  reportUpdatesActed       ReportUpdate[]     @relation("ReportUpdateActor")
  letterRequests           LetterRequest[]    @relation("LetterRequester")
  reviewedLetterRequests   LetterRequest[]    @relation("LetterReviewer")
  facilityBookings         FacilityBooking[]  @relation("FacilityBookingCreator")
  waivedInvoices           Invoice[]          @relation("InvoiceWaivedBy")
  submittedPayments        Payment[]          @relation("PaymentSubmitter")
  verifiedPayments         Payment[]          @relation("PaymentVerifier")
  recordedCashTransactions CashTransaction[]  @relation("CashTransactionRecorder")
  pushTokens               PushToken[]
  auditLogs                AuditLog[]         @relation("AuditActor")
  forumMessages            ForumMessage[]       @relation("ForumMessageAuthor")
  createdForumChannels     ForumChannel[]       @relation("ForumChannelCreator")
  forumMemberships         ForumChannelMember[] @relation("ForumChannelMemberUser")
  sentForumInvites         ForumChannelMember[] @relation("ForumChannelMemberInviter")
  forumPosts               ForumPost[]          @relation("ForumPostAuthor")
  forumPostReplies         ForumPostReply[]     @relation("ForumPostReplyAuthor")
  forumPostLikes           ForumPostLike[]
  forumReplyLikes          ForumReplyLike[]

  @@map("users")
}

model OtpRequest {
  id            String    @id @default(uuid()) @db.Uuid
  phoneE164     String    @map("phone_e164") @db.VarChar(16)
  codeDigest    String    @map("code_digest") @db.Char(64)
  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @default(5) @map("max_attempts")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

model Session {
  id                 String     @id @default(uuid()) @db.Uuid
  userId             String     @map("user_id") @db.Uuid
  tokenDigest        String     @unique @map("token_digest") @db.Char(64)
  currentCommunityId String?    @map("current_community_id") @db.Uuid
  currentHouseholdId String?    @map("current_household_id") @db.Uuid
  expiresAt          DateTime   @map("expires_at") @db.Timestamptz(3)
  lastSeenAt         DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt          DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCommunity   Community? @relation("CurrentCommunity", fields: [currentCommunityId], references: [id], onDelete: Restrict)
  currentHousehold   Household? @relation("CurrentHousehold", fields: [currentHouseholdId], references: [id], onDelete: Restrict)
  auditLogs          AuditLog[]

  @@index([userId, expiresAt])
  @@index([currentCommunityId, currentHouseholdId])
  @@map("sessions")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(64)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(120)
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  rtId        String?   @map("rt_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  rt          Rt?       @relation(fields: [rtId, communityId], references: [id, communityId], onDelete: Restrict)

  @@unique([userId, communityId, roleId])
  @@index([communityId, roleId])
  @@map("user_roles")
}

model Rt {
  id            String         @id @default(uuid()) @db.Uuid
  communityId   String         @map("community_id") @db.Uuid
  code          String         @db.VarChar(16)
  name          String         @db.VarChar(120)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(3)
  community     Community      @relation(fields: [communityId], references: [id], onDelete: Restrict)
  houses        House[]
  userRoles     UserRole[]
  forumChannels ForumChannel[]

  @@unique([communityId, code])
  @@unique([id, communityId])
  @@index([communityId, deletedAt])
  @@map("rts")
}

model ForumChannel {
  id              String               @id @default(uuid()) @db.Uuid
  communityId     String               @map("community_id") @db.Uuid
  rtId            String?              @map("rt_id") @db.Uuid
  kind            ForumChannelKind     @default(SYSTEM)
  name            String               @db.VarChar(160)
  description     String?              @db.VarChar(500)
  createdByUserId String?              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  community       Community            @relation(fields: [communityId], references: [id], onDelete: Restrict)
  rt              Rt?                  @relation(fields: [rtId, communityId], references: [id, communityId], onDelete: Restrict)
  createdBy       User?                @relation("ForumChannelCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  members         ForumChannelMember[]
  messages        ForumMessage[]

  @@unique([id, communityId])
  @@index([communityId, rtId])
  @@index([communityId, kind])
  @@map("forum_channels")
}

/// Invitation + membership for a PRIVATE forum. A row in PENDING is an
/// outstanding invitation the invitee can accept or decline; only ACCEPTED
/// rows may read or post in the channel.
model ForumChannelMember {
  id              String            @id @default(uuid()) @db.Uuid
  communityId     String            @map("community_id") @db.Uuid
  channelId       String            @map("channel_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  status          ForumMemberStatus @default(PENDING)
  isOwner         Boolean           @default(false) @map("is_owner")
  invitedByUserId String?           @map("invited_by_user_id") @db.Uuid
  invitedAt       DateTime          @default(now()) @map("invited_at") @db.Timestamptz(3)
  respondedAt     DateTime?         @map("responded_at") @db.Timestamptz(3)
  community       Community         @relation(fields: [communityId], references: [id], onDelete: Restrict)
  channel         ForumChannel      @relation(fields: [channelId, communityId], references: [id, communityId], onDelete: Cascade)
  user            User              @relation("ForumChannelMemberUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy       User?             @relation("ForumChannelMemberInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([channelId, userId])
  @@index([communityId, userId, status])
  @@map("forum_channel_members")
}

model ForumMessage {
  id               String         @id @default(uuid()) @db.Uuid
  communityId      String         @map("community_id") @db.Uuid
  channelId        String         @map("channel_id") @db.Uuid
  authorUserId     String         @map("author_user_id") @db.Uuid
  replyToMessageId String?        @map("reply_to_message_id") @db.Uuid
  body             String         @db.Text
  imageUrls        String[]       @default([]) @map("image_urls")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt         DateTime?      @map("edited_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)
  community        Community      @relation(fields: [communityId], references: [id], onDelete: Restrict)
  channel          ForumChannel   @relation(fields: [channelId, communityId], references: [id, communityId], onDelete: Restrict)
  author           User           @relation("ForumMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  replyTo          ForumMessage?  @relation("ForumMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ForumMessage[] @relation("ForumMessageReply")

  @@unique([id, communityId])
  @@index([communityId, channelId, createdAt])
  @@map("forum_messages")
}

/// A threaded discussion-board post — the "Forum Warga" board, which lives
/// alongside the realtime chat channels rather than replacing them. A post has
/// a title, a category, likes, and replies; a chat message has none of those.
model ForumPost {
  id           String            @id @default(uuid()) @db.Uuid
  communityId  String            @map("community_id") @db.Uuid
  authorUserId String            @map("author_user_id") @db.Uuid
  category     ForumPostCategory @default(INFORMATION)
  title        String            @db.VarChar(240)
  body         String            @db.Text
  imageUrls    String[]          @default([]) @map("image_urls")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt     DateTime?         @map("edited_at") @db.Timestamptz(3)
  deletedAt    DateTime?         @map("deleted_at") @db.Timestamptz(3)
  community    Community         @relation(fields: [communityId], references: [id], onDelete: Restrict)
  author       User              @relation("ForumPostAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  replies      ForumPostReply[]
  likes        ForumPostLike[]

  @@unique([id, communityId])
  @@index([communityId, createdAt])
  @@index([communityId, category, createdAt])
  @@map("forum_posts")
}

model ForumPostReply {
  id             String           @id @default(uuid()) @db.Uuid
  communityId    String           @map("community_id") @db.Uuid
  postId         String           @map("post_id") @db.Uuid
  authorUserId   String           @map("author_user_id") @db.Uuid
  /// Quotes another reply in the same post, so a back-and-forth stays
  /// readable without nesting the list arbitrarily deep.
  replyToReplyId String?          @map("reply_to_reply_id") @db.Uuid
  body           String           @db.Text
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime?        @map("edited_at") @db.Timestamptz(3)
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  community      Community        @relation(fields: [communityId], references: [id], onDelete: Restrict)
  post           ForumPost        @relation(fields: [postId, communityId], references: [id, communityId], onDelete: Cascade)
  author         User             @relation("ForumPostReplyAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  replyTo        ForumPostReply?  @relation("ForumReplyQuote", fields: [replyToReplyId], references: [id], onDelete: SetNull)
  quotedBy       ForumPostReply[] @relation("ForumReplyQuote")
  likes          ForumReplyLike[]

  @@unique([id, communityId])
  @@index([communityId, postId, createdAt])
  @@map("forum_post_replies")
}

model ForumPostLike {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  postId      String    @map("post_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  post        ForumPost @relation(fields: [postId, communityId], references: [id, communityId], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([communityId, userId])
  @@map("forum_post_likes")
}

model ForumReplyLike {
  id          String         @id @default(uuid()) @db.Uuid
  communityId String         @map("community_id") @db.Uuid
  replyId     String         @map("reply_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Restrict)
  reply       ForumPostReply @relation(fields: [replyId, communityId], references: [id, communityId], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([communityId, userId])
  @@map("forum_reply_likes")
}

model House {
  id                 String          @id @default(uuid()) @db.Uuid
  communityId        String          @map("community_id") @db.Uuid
  rtId               String?         @map("rt_id") @db.Uuid
  code               String          @db.VarChar(24)
  block              String          @db.VarChar(16)
  number             String          @db.VarChar(16)
  occupancyStatus    OccupancyStatus @default(OWNER_OCCUPIED) @map("occupancy_status")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)
  community          Community       @relation(fields: [communityId], references: [id], onDelete: Restrict)
  rt                 Rt?             @relation(fields: [rtId, communityId], references: [id, communityId], onDelete: Restrict)
  household          Household?
  requestedResidents Resident[]      @relation("RequestedHouse")

  @@unique([communityId, code])
  @@unique([id, communityId])
  @@index([communityId, block, number])
  @@index([communityId, rtId])
  @@map("houses")
}

model Household {
  id               String            @id @default(uuid()) @db.Uuid
  communityId      String            @map("community_id") @db.Uuid
  houseId          String            @unique @map("house_id") @db.Uuid
  displayName      String            @map("display_name") @db.VarChar(160)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(3)
  community        Community         @relation(fields: [communityId], references: [id], onDelete: Restrict)
  house            House             @relation(fields: [houseId, communityId], references: [id, communityId], onDelete: Restrict)
  members          HouseholdMember[]
  activeSessions   Session[]         @relation("CurrentHousehold")
  vehicles         Vehicle[]
  visitors         Visitor[]
  packages         Package[]
  reports          Report[]
  letterRequests   LetterRequest[]
  facilityBookings FacilityBooking[]
  invoices         Invoice[]

  @@unique([id, communityId])
  @@unique([houseId, communityId])
  @@index([communityId])
  @@map("households")
}

model Resident {
  id                    String                 @id @default(uuid()) @db.Uuid
  communityId           String                 @map("community_id") @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  fullName              String                 @map("full_name") @db.VarChar(160)
  status                ResidentStatus         @default(PENDING)
  requestedHouseId      String?                @map("requested_house_id") @db.Uuid
  requestedRelationship HouseholdRelationship? @map("requested_relationship")
  requestedAt           DateTime               @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt            DateTime?              @map("approved_at") @db.Timestamptz(3)
  approvedByUserId      String?                @map("approved_by_user_id") @db.Uuid
  rejectedAt            DateTime?              @map("rejected_at") @db.Timestamptz(3)
  rejectedByUserId      String?                @map("rejected_by_user_id") @db.Uuid
  rejectionReason       String?                @map("rejection_reason") @db.Text
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  community             Community              @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user                  User                   @relation("ResidentUser", fields: [userId], references: [id], onDelete: Restrict)
  requestedHouse        House?                 @relation("RequestedHouse", fields: [requestedHouseId, communityId], references: [id, communityId], onDelete: Restrict)
